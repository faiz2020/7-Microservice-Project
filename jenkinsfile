
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/faiz2020/7-Microservice-Project.git'
            }
        }

        stage('Project Validation') {
            steps {
                sh '''
                    echo "===== MICROSERVICES ====="
                    ls services/
                    echo "===== DOCKERFILES ====="
                    find services frontend -name Dockerfile
                '''
            }
        }

        stage('Docker Image Build') {
            steps {
                sh '''
                    set -e

                    echo "===== BUILDING BACKEND IMAGES ====="

                    for service in \
                        auth-service \
                        catalog-service \
                        inventory-service \
                        order-service \
                        payment-service \
                        notification-service \
                        analytics-service
                    do
                        echo "Building $service"
                        docker build \
                            -t polyglot-$service:dev \
                            -f services/$service/Dockerfile \
                            services/$service
                    done

                    echo "===== BUILDING FRONTEND ====="

                    docker build \
                        -t polyglot-frontend:dev \
                        -f frontend/Dockerfile \
                        frontend

                    echo "===== ALL IMAGES BUILT ====="
                    docker images | grep polyglot-
                '''
            }
        }
        
        
        stage('Push Images to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e
        
                        echo "$DOCKERHUB_TOKEN" | docker login \
                            -u "$DOCKERHUB_USER" --password-stdin
        
                        for service in \
                            auth-service \
                            catalog-service \
                            inventory-service \
                            order-service \
                            payment-service \
                            notification-service \
                            analytics-service
                        do
                            echo "Pushing $service"
        
                            docker tag polyglot-$service:dev \
                                $DOCKERHUB_USER/polyglot-$service:build-$BUILD_NUMBER
        
                            docker push \
                                $DOCKERHUB_USER/polyglot-$service:build-$BUILD_NUMBER
                        done
        
                        echo "Pushing frontend"
        
                        docker tag polyglot-frontend:dev \
                            $DOCKERHUB_USER/polyglot-frontend:build-$BUILD_NUMBER
        
                        docker push \
                            $DOCKERHUB_USER/polyglot-frontend:build-$BUILD_NUMBER
        
                        docker logout
                    '''
                }
            }
        }
        
        
  
stage('Deploy to Kubernetes') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'dockerhub-creds',
                usernameVariable: 'DOCKERHUB_USER',
                passwordVariable: 'DOCKERHUB_TOKEN'
            )
        ]) {
            withEnv(['KUBECONFIG=/tmp/jenkins-kubeconfig']) {
                sh '''
                    set -e

                    echo "Deploying build-$BUILD_NUMBER to Kubernetes..."

                    for service in auth-service catalog-service inventory-service order-service payment-service notification-service analytics-service frontend
                    do
                        image="$DOCKERHUB_USER/polyglot-$service:build-$BUILD_NUMBER"

                        echo "Updating $service with $image"

                        kubectl set image deployment/"$service" \
                          "$service=$image" \
                          -n polyglot-commerce

                        kubectl patch deployment "$service" \
                          -n polyglot-commerce \
                          --type=strategic \
                          -p '{"spec":{"template":{"spec":{"containers":[{"name":"'"$service"'","imagePullPolicy":"Always"}]}}}}'
                    done

                    echo "Waiting for deployment rollouts..."

                    for service in auth-service catalog-service inventory-service order-service payment-service notification-service analytics-service frontend
                    do
                        kubectl rollout status deployment/"$service" \
                          -n polyglot-commerce \
                          --timeout=180s
                    done

                    echo "Final deployment status:"
                    kubectl get deployments -n polyglot-commerce
                    kubectl get pods -n polyglot-commerce
                '''
            }
        }
    }
}


    }
}
