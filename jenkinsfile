pipeline {
    agent any

    environment {
        GITOPS_REPO = 'https://github.com/faiz2020/7-Microservice-Project-GitOps.git'
        GITOPS_BRANCH = 'main'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/faiz2020/7-Microservice-Project.git'
            }
        }

        stage('Project Validation') {
            steps {
                sh '''
                    set -e
                    echo "===== MICROSERVICES ====="
                    ls services/
                    echo "===== DOCKERFILES ====="
                    find services frontend -name Dockerfile
                '''
            }
        }

        stage('Docker Image Build') {
            steps {
                sh '''
                    set -e

                    for service in \
                        auth-service \
                        catalog-service \
                        inventory-service \
                        order-service \
                        payment-service \
                        notification-service \
                        analytics-service
                    do
                        echo "Building $service"
                        docker build \
                            -t polyglot-$service:dev \
                            -f services/$service/Dockerfile \
                            services/$service
                    done

                    docker build \
                        -t polyglot-frontend:dev \
                        -f frontend/Dockerfile \
                        frontend

                    echo "===== ALL IMAGES BUILT ====="
                    docker images | grep polyglot-
                '''
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "$DOCKERHUB_TOKEN" | docker login \
                            -u "$DOCKERHUB_USER" --password-stdin

                        for service in \
                            auth-service \
                            catalog-service \
                            inventory-service \
                            order-service \
                            payment-service \
                            notification-service \
                            analytics-service \
                            frontend
                        do
                            image="$DOCKERHUB_USER/polyglot-$service:build-$BUILD_NUMBER"

                            echo "Pushing $image"

                            docker tag polyglot-$service:dev "$image"
                            docker push "$image"
                        done

                        docker logout
                    '''
                }
            }
        }

        stage('Update GitOps Repository') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'gitops-github-creds',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    ),
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        rm -rf gitops-repo

                        git clone \
                            --branch "$GITOPS_BRANCH" \
                            "https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/faiz2020/7-Microservice-Project-GitOps.git" \
                            gitops-repo

                        cd gitops-repo

                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@localhost"

                        for service in \
                            auth-service \
                            catalog-service \
                            inventory-service \
                            order-service \
                            payment-service \
                            notification-service \
                            analytics-service \
                            frontend
                        do
                            manifest="apps/polyglot-commerce/$service/deployment.yaml"
                            image="$DOCKERHUB_USER/polyglot-$service:build-$BUILD_NUMBER"

                            echo "Updating $service to $image"

                            sed -i \
                                "s|image: .*|image: $image|" \
                                "$manifest"
                        done

                        echo "===== UPDATED IMAGE TAGS ====="
                        grep -R 'image:' apps/polyglot-commerce/

                        git add apps/polyglot-commerce/

                        if git diff --cached --quiet; then
                            echo "No GitOps manifest changes detected."
                        else
                            git commit -m "Deploy build-$BUILD_NUMBER through GitOps"
                            git push origin "$GITOPS_BRANCH"
                        fi

                        echo "===== GITOPS UPDATE COMPLETED ====="
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI completed. Argo CD will deploy the updated GitOps manifests.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}
